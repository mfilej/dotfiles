#!/bin/sh

# Read a git patch from stdin and open it in a fresh cmux window.
# Keep this script quiet: jjui should immediately return to the UI.

window=$(cmux new-window 2>/dev/null | awk '/^OK / { print $2; exit }')

if [ -n "$window" ]; then
  json=$(cmux --json diff - --window "$window" --focus true 2>/dev/null) || exit 0

  # A fresh cmux window starts with an initial terminal split; `cmux diff` then
  # opens the browser diff as a split beside it. Close that initial source
  # surface so the new window contains only the diff viewer.
  source_surface=$(printf '%s' "$json" | python3 -c 'import json, sys; d=json.load(sys.stdin); print(d.get("source_surface_ref") or "")' 2>/dev/null)
  if [ -n "$source_surface" ]; then
    cmux close-surface --surface "$source_surface" --window "$window" >/dev/null 2>&1 || true
  fi

  cmux focus-window --window "$window" >/dev/null 2>&1 || true
else
  # Fallback: if creating a new window fails, still open the diff in the
  # current cmux workspace.
  cmux diff - --focus true >/dev/null 2>&1 || true
fi

exit 0
