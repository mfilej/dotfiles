#!/bin/sh

# Fire-and-forget jj diff -> cmux diff helper for jjui.
# Usage: jjui-cmux-diff-jj <change> [file]

change=$1
file=$2

[ -n "$change" ] || exit 0

log=${JJUI_CMUX_DIFF_LOG:-/tmp/jjui-cmux-diff.log}
{
  printf '[%s] start cwd=%s change=%s file=%s CMUX_WORKSPACE_ID=%s CMUX_SURFACE_ID=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$PWD" "$change" "$file" "${CMUX_WORKSPACE_ID:-}" "${CMUX_SURFACE_ID:-}"

  if [ -n "$file" ]; then
    jj diff --git -r "$change" -- "$file"
  else
    jj diff --git -r "$change"
  fi | ~/.local/bin/jjui-cmux-diff

  printf '[%s] done status=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$?"
} >>"$log" 2>&1

exit 0
